rules_version = '2';

// Security Rules — Kinesalud y Vida.
// Principio: todo está denegado salvo lo que se permite explícitamente.
// Las escrituras de negocio pasan por Cloud Functions (Admin SDK, que no está
// sujeto a estas reglas). Ver docs/firestore.md y docs/roles-permisos.md.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers (claims asignados por Cloud Functions) ----------
    function signedIn() {
      return request.auth != null;
    }
    function isActive() {
      return signedIn() && request.auth.token.active == true;
    }
    function hasRole(role) {
      return isActive() && request.auth.token.role == role;
    }
    function isAdmin() {
      return hasRole('ADMINISTRADOR');
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }
    // Roles con alcance total sobre la operación del consultorio.
    function isFrontDesk() {
      return hasRole('ADMINISTRADOR') || hasRole('RECEPCIONISTA');
    }
    // Ficha de profesional de la sesión (PROFESIONAL, o ADMINISTRADOR que atiende).
    function myProfessionalId() {
      return request.auth.token.get('professionalId', null);
    }
    function ownsProfessionalRecord(professionalId) {
      return isActive() && myProfessionalId() != null && professionalId == myProfessionalId();
    }

    // ---------- Catálogos (lectura para todo el personal; escritura vía Functions) ----------
    match /professionals/{professionalId} {
      allow read: if isActive();
      allow write: if false;
    }
    // Ausencias: la agenda de todo el personal las necesita para mostrar disponibilidad.
    match /professionalExceptions/{exceptionId} {
      allow read: if isActive();
      allow write: if false;
    }
    match /rooms/{roomId} {
      allow read: if isActive();
      allow write: if false;
    }
    match /services/{serviceId} {
      allow read: if isActive();
      allow write: if false;
    }
    match /settings/{settingId} {
      allow read: if isActive();
      allow write: if false;
    }

    // ---------- Operación (datos administrativos, nunca clínicos) ----------
    match /clients/{clientId} {
      allow read: if isFrontDesk()
        || (isActive() && myProfessionalId() != null
            && myProfessionalId() in resource.data.assignedProfessionalIds);
      allow write: if false;
    }
    match /appointments/{appointmentId} {
      allow read: if isFrontDesk() || ownsProfessionalRecord(resource.data.professionalId);
      allow write: if false;

      // Historial inmutable: lo ve quien puede ver la cita (el profesional actual,
      // aunque los eventos antiguos sean de antes de una reprogramación).
      match /events/{eventId} {
        allow read: if isFrontDesk()
          || ownsProfessionalRecord(
               get(/databases/$(database)/documents/appointments/$(appointmentId)).data.professionalId);
        allow write: if false;
      }
    }
    match /treatments/{treatmentId} {
      allow read: if isFrontDesk() || ownsProfessionalRecord(resource.data.professionalId);
      allow write: if false;
    }

    // ---------- Caja y cobros (escritura solo vía Functions) ----------
    // El profesional ve lo que generaron sus propias sesiones.
    match /payments/{paymentId} {
      allow read: if isFrontDesk() || ownsProfessionalRecord(resource.data.professionalId);
      allow write: if false;
    }
    match /cashSessions/{sessionId} {
      allow read: if isFrontDesk();
      allow write: if false;
    }
    match /cashRegister/{docId} {
      allow read: if isFrontDesk();
      allow write: if false;
    }
    // Ingresos globales del mes (por profesional y por área): solo administración.
    match /incomeStats/{month} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------- Información clínica (Fase 12) ----------
    // Cerrada para la web, también para la administración: se lee y se escribe
    // solo por Cloud Functions, que verifican el acceso y auditan cada uso.
    match /clinicalRecords/{clientId}/{document=**} {
      allow read, write: if false;
    }
    match /clinicalRecords/{clientId} {
      allow read, write: if false;
    }

    // ---------- Reportes (resúmenes diarios que mantiene un trigger) ----------
    // Citas por día: reportes operativos de recepción y administración.
    match /dailyStats/{date} {
      allow read: if isFrontDesk();
      allow write: if false;
    }
    // Ingresos por día: solo administración.
    match /dailyIncome/{date} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------- Usuarios ----------
    match /users/{uid} {
      // Cada persona lee su propia cuenta; el administrador lee todas.
      allow read: if isActive() && (isSelf(uid) || isAdmin());
      // Único cambio permitido desde la web: registrar el último acceso propio.
      allow update: if isActive() && isSelf(uid)
        && onlyChanges(['lastLoginAt'])
        && request.resource.data.lastLoginAt == request.time;
      allow create, delete: if false;

      // Dispositivos para notificaciones push: cada persona registra los suyos.
      match /devices/{deviceId} {
        allow read, delete: if isActive() && isSelf(uid);
        allow create, update: if isActive() && isSelf(uid)
          && request.resource.data.keys().hasOnly(['token', 'userAgent', 'createdAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() < 4096
          && request.resource.data.createdAt == request.time;
      }
    }

    // ---------- Recordatorios y notificaciones (Fase 13) ----------
    match /reminders/{reminderId} {
      allow read: if isFrontDesk();
      allow write: if false;
    }
    // Bandeja in-app: cada persona ve las suyas y solo puede marcarlas como leídas.
    match /notifications/{notificationId} {
      allow read: if isActive() && resource.data.userId == request.auth.uid;
      allow update: if isActive() && resource.data.userId == request.auth.uid
        && onlyChanges(['read'])
        && request.resource.data.read == true;
      allow create, delete: if false;
    }

    // ---------- Auditoría (solo escritura desde el servidor) ----------
    match /auditLogs/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------- Todo lo demás: denegado hasta que su módulo lo habilite ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
