{
  "name": "@kinesalud/functions",
  "version": "0.1.0",
  "private": true,
  "description": "Backend Node.js (Cloud Functions 2.ª generación) — comandos de negocio, triggers y tareas programadas",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:emulator": "vitest run --config vitest.emulator.config.ts"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@kinesalud/shared": "*",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "vitest": "^5.0.2"
  }
}
