# Configuración pública del proyecto de Firebase (Consola → Configuración del proyecto → Tus apps).
# Estos valores identifican el proyecto; la seguridad la dan Auth + Security Rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=demo-kinesalud
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Región de Cloud Functions (southamerica-east1 = São Paulo, la más cercana a Bolivia).
VITE_FIREBASE_FUNCTIONS_REGION=southamerica-east1

# true = conectar con Firebase Emulator Suite local (desarrollo).
VITE_USE_EMULATORS=true

# Clave pública "Web Push" (Consola → Configuración del proyecto → Cloud Messaging →
# Certificados push web). Opcional: sin ella no se ofrecen las notificaciones push.
VITE_FIREBASE_VAPID_KEY=
